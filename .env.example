# ╔══════════════════════════════════════════════════════════╗
# ║  SmartERP Backend — Required Environment Variables      ║
# ║  Copy to .env and fill in all values before running     ║
# ╚══════════════════════════════════════════════════════════╝

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Per-process pool cap. Keep at 4 for Render's master + two workers using the
# Supabase 15-client session pooler; size lower if multiple service instances run.
DB_POOL_MAX=4
# DB_SSL controls certificate verification for the DB connection:
#   true      → verify certificate (recommended for production)
#   no-verify → encrypt but skip cert check (some managed/hosted DBs require this)
#   false     → no SSL (local dev only)
DB_SSL=true

# ── App ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
WEB_CONCURRENCY=2
BASE_URL=https://your-backend-url.onrender.com
BACKEND_URL=https://your-backend-url.onrender.com

# ── Auth / JWT ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Frontend Origins (for CORS) ───────────────────────────────
FRONTEND_ORIGIN=https://www.prozync.in
CUSTOMER_PORTAL_ORIGIN=https://client.prozync.in

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Firebase Admin SDK ────────────────────────────────────────
# Option A: Pass the full service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT=

# Option B: Individual fields (use either A or B, not both)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Subscription migration 037: use only after a DBA provisions a dedicated,
# isolated test database and its read-only smarterp_test_database_identity row.
# SMARTERP_ENVIRONMENT=isolated_test
# SMARTERP_SUBSCRIPTION_TEST_DATABASE_URL=postgresql://migration_role:replace_me@isolated-test-host:5432/smarterp_test
# SMARTERP_SUBSCRIPTION_TEST_DATABASE=smarterp_test
# SMARTERP_SUBSCRIPTION_TEST_DATABASE_HOST=isolated-test-host
# SMARTERP_SUBSCRIPTION_TEST_DATABASE_PORT=5432
# SMARTERP_SUBSCRIPTION_TEST_DATABASE_ROLE=migration_role
# SMARTERP_SUBSCRIPTION_TEST_DATABASE_OID=replace_with_DBA_confirmed_database_oid
# SMARTERP_SUBSCRIPTION_TEST_ISOLATION_ID=replace_with_DBA_approval_id
# SMARTERP_SUBSCRIPTION_SEED_CONFIRM=APPLY_TO_CONFIRMED_TEST_DATABASE

# ── Razorpay ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Groq AI ───────────────────────────────────────────────────
GROQ_API_KEY=

# ── Sentry ────────────────────────────────────────────────────
SENTRY_DSN=

# ── Super Admin ───────────────────────────────────────────────
SUPER_ADMIN_EMAIL=

# ── Admin Panel ───────────────────────────────────────────────
# Choose a long random string — this is the URL segment for the super-admin panel
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# NEVER use the default or any guessable value
ADMIN_ROUTE=
